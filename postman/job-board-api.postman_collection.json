            "body": {
              "mode": "raw",
              "raw": "{\"token\":\"{{resetToken}}\",\"newPassword\":\"YeniSifre123\"}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "  pm.collectionVariables.set('candidateToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Şifre Değiştir",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{candidateToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\":\"Password123!\",\"newPassword\":\"YeniSifre123\"}"
            },
            "url": "{{baseUrl}}/api/auth/change-password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
