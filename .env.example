# Veritabanı (uygulama tarafı)
DB_URL=jdbc:postgresql://localhost:5432/jobboard
DB_USERNAME=jobboard
DB_PASSWORD=buraya-guclu-bir-sifre-yazin

# JWT imzalama anahtarları (en az 32 karakter; refresh için ayrı secret önerilir)
JWT_SECRET=buraya-en-az-32-karakterlik-gizli-anahtar-yazin
JWT_REFRESH_SECRET=buraya-en-az-32-karakterlik-ayri-refresh-anahtari-yazin

# MinIO (uygulamanın bağlandığı credential'lar)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=buraya-guclu-bir-minio-sifresi-yazin
MINIO_BUCKET=job-board-cvs

# E-posta
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025

# Uygulama davranışı (opsiyonel)
WEB_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
FORWARD_HEADERS_STRATEGY=none

# docker-compose servis credential'ları (yukarıdakilerle aynı olabilir)
POSTGRES_USER=jobboard
POSTGRES_PASSWORD=buraya-guclu-bir-sifre-yazin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=buraya-guclu-bir-minio-sifresi-yazin
