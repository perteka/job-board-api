# =============================================================================
# Job Board & Application API — .env.example
# Bu dosya ortam değişkenlerinin referansıdır.
# Kopyalayın: cp .env.example .env
# Gerçek değerleri doldurun. .env dosyası asla depoya commitlenmez.
# =============================================================================

# ---------------------------------------------------------------
# Veritabanı (PostgreSQL)
# ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/jobboard
DB_USERNAME=jobboard
DB_PASSWORD=

# ---------------------------------------------------------------
# JWT (en az 32 karakterlik rastgele bir değer gereklidir)
# ---------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------
# MinIO (S3-uyumlu dosya depolama)
# ---------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=job-board-cvs

# ---------------------------------------------------------------
# E-posta (Spring Mail / Mailpit)
# ---------------------------------------------------------------
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025

# ---------------------------------------------------------------
# Docker Compose servis kimlik bilgileri
# ---------------------------------------------------------------
POSTGRES_USER=jobboard
POSTGRES_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
